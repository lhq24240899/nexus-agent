# Nexus 双核 Agent 环境变量配置模板
# 复制为 .env 并填入实际值

# ============ 决策核心 (Nexus) ============
DECISION_BASE_URL=https://api.ephone.ai/v1
DECISION_API_KEY=sk-your-decision-key
DECISION_MODEL=deepseek-v4-flash-vision-exp

# ============ 秘书核心 ============
SECRETARY_BASE_URL=https://api.ephone.ai/v1
SECRETARY_API_KEY=sk-your-secretary-key
SECRETARY_MODEL=deepseek-v4-flash

# 兜底: 如果上面两个都没配, 用这个
# DS_API_KEY=sk-your-shared-key

# ============ Embedding (向量检索) ============
EMBED_BASE_URL=https://api.ephone.ai/v1
EMBED_API_KEY=sk-your-embed-key
EMBED_MODEL=text-embedding-3-small
EMBED_DIM=1536
USE_EMBEDDING=1

# ============ 模型分级路由 ============
# WORK_MODEL=deepseek-v4-flash-vision-exp
# CHAT_MODEL=deepseek-v4-flash
# BRAINSTORM_MODEL=deepseek-v4-flash

# ============ Linux 嵌入 ============
# LINUX_MODE=auto  # auto / docker / wsl / mock
# WSL_DISTRO=Ubuntu

# ============ Web UI ============
# WEB_PORT=7860

# ============ 搜索 API (至少配一个) ============
TAVILY_API_KEY=tvly-your-key
# SERPER_API_KEY=
# BAIDU_API_KEY=
# SEARCH_PREFERRED=tavily

# ============ IMA 腾讯笔记同步 (可选) ============
# IMA_CLIENT_ID=
# IMA_API_KEY=
# IMA_SYNC_FOLDER=Nexus经验库
# IMA_SYNC_ENABLED=true

# ============ 成本监控 (可选, 用于校准单价) ============
# COST_DECISION_INPUT=1.5
# COST_DECISION_OUTPUT=4.5
# COST_SECRETARY_INPUT=1.0
# COST_SECRETARY_OUTPUT=2.0
# COST_EMBED_INPUT=0.02
# COST_EMBED_OUTPUT=0.0
